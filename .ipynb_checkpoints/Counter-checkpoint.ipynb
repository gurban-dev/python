    "element appears."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "b08598cd-c6ee-4f41-af82-008a75290e38",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Counter({'apple': 3, 'banana': 2, 'orange': 1})\n"
     ]
    }
   ],
   "source": [
