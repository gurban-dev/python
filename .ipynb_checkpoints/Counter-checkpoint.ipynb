   "source": [
    "from collections import Counter"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "45ddfdd6-c09c-4560-8f5e-d07a289cacbd",
   "metadata": {},
   "outputs": [],
   "source": [
    "words = ['apple', 'banana', 'apple', 'orange', 'banana', 'apple']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "2b6d9353-df1b-4a1a-82ad-cb8d7921e129",
   "metadata": {},
   "outputs": [],
   "source": [
